# ============================================================
# Finn0616 · 通用 MCP 网关 — 环境变量模板
# ============================================================
# 用法：
#   cp .env.example .env    然后按需填写 / 取消注释，重启生效
#
# ⚠️ 三条重要规则（照做能省掉大部分"改了没生效"的问题）：
#
#   1. 本模板中「默认值非空」的开关一律是注释掉的状态，需要时去掉行首 `#` 再填值。
#      千万不要把它们写成 `VAR=`（空值）—— 那会让代码读到的不是默认值，
#      而是空字符串。例：DEVICE_CONTEXT_ENABLED 写成空会被判定为「关闭」，
#      而不是它本来的默认值「开启」。
#
#   2. 本文件不含任何真实密钥。所有敏感项请自行填写，切勿提交到仓库。
#      （.env 已被 .gitignore 忽略；本模板 .env.example 可以入库。）
#
#   3. 本模板覆盖的是「代码里真正会读取」的变量。少数文档里还写着、
#      但当前代码已无读取点的条目，已在下方对应位置注明。
#
# 保持未注释的只有下面这些基础项，其余按需启用：
#   PORT / API_SECRET / SUPABASE_* / CHAT_*
#
# 完整说明见 VARIABLES.md
# ============================================================


# ------------------------------------------------------------
# 1. 基础部署
# ------------------------------------------------------------
PORT=10000

# ⚠️ 必填。管理接口的安全密钥。
#    留空时：/api/*、/sse、/messages、/mcp 一律返回 503 拒绝访问；
#            但 /v1/*（聊天代理）不受影响、会直接放行 —— 生产环境请务必配置。
#    配置后：以上入口（含 /v1/*）都需带 Authorization: Bearer <secret> 或 X-Api-Key: <secret>
#    生成一个随机值：openssl rand -hex 32
API_SECRET=

# 反代场景下修正 Host 头，一般留空
# GATEWAY_HOST=

# 云平台重启回调 URL（供 /api/restart 调用）。当前代码未读取。
# RESTART_WEBHOOK_URL=

# 日志文件路径（供 /api/logs 读取）。当前代码未读取。
# LOG_FILE=

# 进程角色标识，由 run.py 启动子进程时自动注入，不要手动设置。
# GATEWAY_ROLE=


# ------------------------------------------------------------
# 2. 数据库 (Supabase)
# ------------------------------------------------------------
# 配置后才会启用：记忆 / 画像 / 提醒 / 小屋 / 钱包 / 设备定位 / 上下文注入 / 存库。
# 不配置则相关功能整体优雅降级，网关仍可启动。
# 建表 SQL 见 DEPLOY_ZEABUR.md 附录。
SUPABASE_URL=
# anon key（只读查询，受 RLS 保护）
SUPABASE_KEY=
# service_role key（RPC 写操作：种植/烹饪/钱包等）。缺失时写操作返回 SERVICE_KEY_MISSING
SUPABASE_SERVICE_KEY=


# ------------------------------------------------------------
# 3. 智能体身份（控制 /v1/chat/completions 的人格化行为）
# ------------------------------------------------------------
# 仅当配置了 SUPABASE_URL 时生效（启用注入 + 存库）；不配则纯透传。
# 以下注入由 server._build_channel_context() 统一构建，网页 / Telegram / QQ 三渠道共用。
# USER_NAME=用户
# AI_NAME=助手
# USER_ID=default
# AI_PERSONA=

# 存库时给本轮对话打的标签（用于区分网页/TG/QQ 渠道）
# CHAT_TAG=Web_Chat

# 渠道标签→显示名映射（JSON），注入到 system prompt「当前聊天渠道」
# CHANNEL_DISPLAY_MAP={"Web_Chat":"网页对话","QQ_MSG":"QQ","QQ_Chat":"QQ","QQ_Group":"QQ","TG_MSG":"TG","Email_Process":"邮件"}

# 自动总结阈值：全渠道对话流水累计达到该条数时，自动生成第一人称阶段总结
# SUMMARY_THRESHOLD=30

# 是否把 device_data 最新一条快照注入 system prompt
# DEVICE_CONTEXT_ENABLED=true
# 设备快照中「应用使用榜单」条数（1–10）
# DEVICE_CONTEXT_TOP_APPS=5
# 设备快照中「最近通知」条数（去重后取最近 N 条，设 0 不要通知）
# DEVICE_CONTEXT_MAX_NOTIFS=3
# 应用使用数据超过该小时数视为过期，不予注入
# DEVICE_CONTEXT_APP_MAX_AGE_HOURS=72

# 对话历史注入策略：auto=客户端已带历史时跳过（保 prompt cache 前缀稳定）、always=总是注入、never=从不注入
# INJECT_DB_HISTORY=auto
# 阶段总结（Core_Cognition）注入策略：auto / always / never
# INJECT_CORE_SUMMARIES=auto


# ------------------------------------------------------------
# 4. 多模型 LLM
# ------------------------------------------------------------
# 支持 7 个角色按任务路由。最小化配置只需 CHAT_*，其余角色未配置时自动回退。
# 角色回退顺序：compression/background → CHAT_* → OPENAI_*；deepseek → CHAT_* → 中性
# 角色名：chat / compression / background / silicon1 / vision / voice / deepseek

# —— 主对话模型 CHAT（日常聊天主力，可被数据库 llm_settings 动态覆盖）——
# 最小可运行配置的必需项：至少填 CHAT_API_KEY。
CHAT_API_KEY=
CHAT_BASE_URL=https://api.minimaxi.com/v1
CHAT_MODEL_NAME=abab6.5s-chat

# —— 压缩/总结模型 COMPRESS（对话总结、阶段总结、日记生成）——
# COMPRESS_API_KEY=
# COMPRESS_BASE_URL=
# COMPRESS_MODEL_NAME=

# —— 后台任务模型 BACKGROUND（自主问候、自由活动、提醒播报）——
# BACKGROUND_API_KEY=
# BACKGROUND_BASE_URL=
# BACKGROUND_MODEL_NAME=

# —— 硅基流动 SILICON1（便宜兜底、简单任务）——
# SILICON1_API_KEY=
# SILICON1_BASE_URL=https://api.siliconflow.cn/v1
# SILICON1_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct

# —— DeepSeek（消息情感分类专用，失败自动降级中性）——
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL_NAME=deepseek-v4-flash
# 分类走哪个 provider，可改为 silicon1 / main_chat 等
# CLASSIFY_PROVIDER=deepseek

# —— 视觉模型 VISION（图片识别 / OCR）——
# VISION_API_KEY=
# VISION_BASE_URL=
# VISION_MODEL_NAME=gpt-4o-mini

# —— 语音模型 VOICE（STT 语音转文字）——
# VOICE_API_KEY=
# VOICE_BASE_URL=https://api.openai.com/v1

# —— 向量嵌入（Doubao / 硅基流动）——
# DOUBAO_API_KEY=
# DOUBAO_EMBEDDING_EP=

# —— 默认模型（已废弃，仅向后兼容保留，推荐直接配 CHAT_*）——
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL_NAME=gpt-3.5-turbo
# DEFAULT_API_KEY=
# DEFAULT_BASE_URL=
# DEFAULT_MODEL_NAME=gpt-3.5-turbo


# ------------------------------------------------------------
# 5. 向量记忆 (Pinecone 单写)
# ------------------------------------------------------------
# PINECONE_API_KEY=
# PINECONE_INDEX_NAME=notion-brain-v2
# 用户隔离 ID（兼容旧变量名，仍用于区分用户）
# MEM0_USER_ID=default


# ------------------------------------------------------------
# 6. 通讯渠道
# ------------------------------------------------------------
# —— Telegram ——
# TG_BOT_TOKEN=
# TG_CHAT_ID=
# TG_GROUP_ID=

# —— 邮件 (Resend) ——
# RESEND_API_KEY=
# MY_EMAIL=
# ADMIN_EMAIL=
# Gmail 桥接地址（供信箱巡视器轮询）
# GMAIL_BRIDGE_URL=


# ------------------------------------------------------------
# 7. Google 集成（Gmail 收发 & 日历）
# ------------------------------------------------------------
# OAuth 用户令牌 JSON（序列化为单行字符串）
# GOOGLE_USER_TOKEN_JSON=
# GOOGLE_CALENDAR_ID=primary


# ------------------------------------------------------------
# 8. 地图 / GPS（高德）
# ------------------------------------------------------------
# AMAP_API_KEY=


# ------------------------------------------------------------
# 9. 多媒体生成
# ------------------------------------------------------------
# —— AI 音乐 / 翻唱 (Replicate) ——
# REPLICATE_API_KEY=
# 原创音乐模型 version hash
# MUSIC_MODEL_VERSION=
# RVC 翻唱音色模型 version hash
# VOICE_MODEL_VERSION=

# —— HTML 转图片 (HCTI) ——
# HCTI_API_ID=
# HCTI_API_KEY=


# ------------------------------------------------------------
# 10. 网页搜索
# ------------------------------------------------------------
# 留空时使用 DuckDuckGo 免费兜底（零配置）；配置 Tavily 后切换为高质量搜索
# TAVILY_API_KEY=


# ------------------------------------------------------------
# 11. 云端笔记 (WebDAV，如坚果云)
# ------------------------------------------------------------
# WEBDAV_URL=
# WEBDAV_USER=
# WEBDAV_PASSWORD=


# ------------------------------------------------------------
# 12. NapCat QQ 接入
# ------------------------------------------------------------
# 正向 WS 地址（如 ws://host:3001）
# NAPCAT_WS_URL=
# HTTP 回调地址
# NAPCAT_HTTP_URL=
# NAPCAT_BOT_QQ=
# 限定响应的私聊用户 QQ（留空则所有人可聊）
# NAPCAT_TARGET_USER=
# 掉线通知 QQ，多个用逗号分隔
# NAPCAT_NOTIFY_QQ=
# 掉线同时通知 TG（true/false）
# NAPCAT_NOTIFY_TG=
# 允许响应的群号，逗号分隔
# NAPCAT_ALLOWED_GROUPS=
# 重连初始延迟（秒）
# NAPCAT_RECONNECT_DELAY=5
# 退避乘数
# NAPCAT_BACKOFF_FACTOR=1.5
# 最大重连延迟（秒）
# NAPCAT_MAX_DELAY=60
# Zeabur 平台标识（当前代码未读取）
# NAPCAT_PROJECT_ID=
# NAPCAT_SERVICE_ID=
# ZEABUR_API_KEY=


# ------------------------------------------------------------
# 13. 后台心跳调度
# ------------------------------------------------------------
# 主动问候间隔（秒）
# HEARTBEAT_INTERVAL=7200
# 消息总结间隔（秒）
# SUMMARIZE_INTERVAL=1800
# 日程早播时间
# SCHEDULE_MORNING_TIME=07:30
# 日程晚播时间
# SCHEDULE_EVENING_TIME=22:00
# 每日日记生成时间（北京时间，应 ≥ DIARY_DAY_CUTOFF）
# DIARY_TIME=04:00
# 日记「一日」切点：记忆窗口 [昨天切点, 今天切点)，默认方便半夜聊天归入同一天
# DIARY_DAY_CUTOFF=04:00
# 额外热同步的环境变量键，逗号分隔
# SYNC_KEYS=
# 是否允许夜间主动打扰
# PROACTIVE_ALLOW_NIGHT=false

# —— 宠物小屋 tick ——
# PET_HOUSE_TICK_INTERVAL=3600
# PET_HOUSE_TICK_ENABLED=true

# —— 统一自主活动调度（C5 起合并自由活动与 Home 自主生活）——
# 控制是否把普通自由/外向/秘密日记加入统一候选
# FREE_ACTIVITY_ENABLED=true
# 普通自由活动基础间隔（秒）
# FREE_ACTIVITY_INTERVAL=5400
# 工具调用循环开关（灰度）：开则活动会真正调用工具产生副作用
# FREE_ACTIVITY_TOOL_LOOP=false
# 单轮自由活动最多调用多少个工具
# FREE_ACTIVITY_TOOL_MAX_CALLS=5
# 淘宝 MCP 的完整 Streamable HTTP 端点（含 /mcp 路径）。留空时"逛淘宝"不进候选
# TAOBAO_MCP_URL=

# —— Home Runtime 后台自主生活 ——
# 控制是否把 Home 活动加入统一候选
# HOME_AUTONOMY_ENABLED=false
# 分层灰度：0=关闭 / 1=只读观察 / 2=+低风险写入 / 3=+资源类 / 4=+基础生活
# HOME_AUTONOMY_PHASE=0
# Home-only / 双启用场景下的基础间隔（秒）
# HOME_AUTONOMY_INTERVAL=7200


# ------------------------------------------------------------
# 14. 日历注入（关闭后不再把近期日程写进上下文）
# ------------------------------------------------------------
# CALENDAR_INJECT=true
# 提前注入天数
# CALENDAR_INJECT_DAYS_BEFORE=7
# 延后注入天数
# CALENDAR_INJECT_DAYS_AFTER=7
# 课程表注入：true 时把今日+明日课程写入聊天上下文（数据来自 courses 表）
# COURSE_INJECT=true


# ------------------------------------------------------------
# 15. 记忆去重与消息聚合
# ------------------------------------------------------------
# MEMORY_DEDUP_ENABLED=true
# 去重相似度阈值
# MEMORY_DEDUP_THRESHOLD=0.90
# 记忆最小长度（短于此值不写入）
# MEMORY_MIN_LEN=8
# MSG_AGGREGATE_ENABLED=true


# ------------------------------------------------------------
# 16. 欲望驱动系统（情感 / 欲望引擎）
# ------------------------------------------------------------
# 所有开关默认关。建议先只开 DESIRE_DRIVEN 观察日志，确认行为合理后再逐个打开。
# 总闸：关则只算只存快照供观测，不覆盖行为
# DESIRE_DRIVEN=false
# 维度耦合网（驱动维度间联动，带全局阻尼防自激）
# DESIRE_COUPLING=false
# 自主心跳（间隔按张力/疲劳/时段动态变化）
# HEARTBEAT_AUTONOMY=false
# 想念基线漂移（久没互动时 attachment 地板缓慢抬高，硬封顶 0.45）
# DESIRE_BASELINE_DRIFT=false
# 设备睡眠同步（从 device_data 读真实睡眠，让疲惫按真实睡眠回血）
# SLEEP_FROM_DEVICE=false
# 情感引擎昼夜节律用的时区偏移（UTC+N）
# EMOTION_TZ_OFFSET=8


# ------------------------------------------------------------
# 17. 小钱包 (Virtual Wallet)
# ------------------------------------------------------------
# 每周入账上限（北京时间周一 00:00 重置）
# WALLET_WEEK_CAP=80
# 超出周上限部分折算到加班银行的比率
# WALLET_OVERTIME_RATE=0.5
# 生日周（4月5日 / 11月15日所在周）是否取消上限
# WALLET_BIRTHDAY_WEEK=true
# 单次从加班银行取出的上限
# WALLET_OVERTIME_WITHDRAW_MAX=20
# 每周固定零花钱的默认金额
# WALLET_ALLOWANCE_WEEKLY=25


# ------------------------------------------------------------
# 18. active 记忆上下文注入（长期记忆进聊天）
# ------------------------------------------------------------
# 环境变量，需重启生效。默认关：关闭时注入逻辑完全不执行（连召回都不发生）。
# 开启前请先用 POST /api/memory-context-preview 以真实数据人工核对注入质量。
# ACTIVE_MEMORY_INJECTION_ENABLED=false


# ------------------------------------------------------------
# 19. Prompt Cache 与 thinking 处理
# ------------------------------------------------------------
# user_prof（用户画像）TTL 缓存秒数，设 0 关闭
# STABLE_PREFIX_TTL=300
# core_summaries（阶段总结）TTL 缓存秒数，设 0 关闭
# CORE_SUMMARIES_TTL=300
# 是否给 Claude 的 system 消息加 cache_control 标记：auto / true / false
# CLAUDE_CACHE_CONTROL=auto
# 存库时是否保留模型思考过程（<think>…</think>）
# SAVE_THINKING=false
# 转发时是否把 <thinking>…</thinking> 改写为 <think>…</think>：留空=自动 / true / false
# REWRITE_THINKING_TAG=


# ------------------------------------------------------------
# 20. 天气工具（wttr.in，无需 API Key）
# ------------------------------------------------------------
# 天气功能总开关
# WEATHER_TOOLS_ENABLED=true
# GPS 缺失时的回退城市
# WEATHER_DEFAULT_CITY=Beijing
# wttr.in 请求超时秒
# WEATHER_TIMEOUT_SEC=12
# 聊天命中天气关键词时主动注入（保流式）
# WEATHER_KEYWORD_INJECT=true
# 网页聊天天气 tool loop 开关（开则轮次内非真流式）
# WEATHER_TOOL_LOOP=false
# tool loop 最大轮次
# WEATHER_TOOL_MAX_ROUNDS=3


# ------------------------------------------------------------
# 21. 其他可选
# ------------------------------------------------------------
# 触发静音的关键词，逗号分隔（当前代码未读取）
# MUTE_KEYWORDS=
# 静音持续秒数（当前代码未读取）
# MUTE_DURATION=300
# 是否开启 QQ 图片 OCR（当前代码未读取）
# OCR_ENABLED=false
# 单次最多识别图片数（当前代码未读取）
# OCR_MAX_IMAGES=3
# Minimax TTS 文字转语音 Key（当前代码未读取）
# MINIMAX_API_KEY=
# STT 语音识别（硅基流动，当前代码未读取）
# SILICON_API_KEY=
# SILICON_STT_BASE_URL=
# SILICON_STT_MODEL=


# ============================================================
# 最小可运行配置（只填这 4 项即可启动并提供基础 MCP 工具）
#   PORT=10000
#   API_SECRET=<随机密钥>
#   CHAT_API_KEY=<你的模型 Key>
#   CHAT_MODEL_NAME=abab6.5s-chat
# 其余全部可留空，未配置的功能会优雅降级而非报错。
# ============================================================
